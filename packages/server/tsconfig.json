{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2020",
    "lib": ["es2020"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "suppressImplicitAnyIndexErrors": true,
    "noEmitOnError": false,
    "noEmit": false,
    "strict": false,
    "noImplicitThis": false,
    "alwaysStrict": false
  },
  "exclude": ["node_modules"]
}
